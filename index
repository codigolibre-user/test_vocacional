    {carreras:["Contabilidad","Auditoría","Gestión Financiera"], q:"¿Te interesa el mundo financiero y contable?"},
    {carreras:["Comercio Exterior","Gestión y Negocios Internacionales","Comercio Electrónico"], q:"¿Prefieres el comercio y los negocios internacionales?"},
    {carreras:["Emprendedores","Comercio Electrónico"], q:"¿Quieres crear tu propio emprendimiento?"}
  ],
  "Educación Física":[
    {carreras:["Pedagogía en Educación Física"], q:"¿Quieres ser profesor/a de educación física?"},
    {carreras:["Cultura Física, Deportes y Rehabilitación"], q:"¿Prefieres el entrenamiento deportivo y alto rendimiento?"},
    {carreras:["Educación de Párvulos","Estimulación Temprana"], q:"¿Quieres trabajar con niños en desarrollo?"},
    {carreras:["Educación Especial","Psicopedagogía"], q:"¿Prefieres la atención especial a personas con discapacidades?"}
  ],
  "Educación Cultural y Artística":[
    {carreras:["Pedagogía en Educación Cultural y Artística"], q:"¿Quieres enseñar arte y cultura?"},
    {carreras:["Diseño Gráfico","Dibujo Publicitario","Gestión Gráfica y Publicitaria"], q:"¿Prefieres el diseño visual y gráfico?"},
    {carreras:["Diseño de Modas","Diseño de Joyas"], q:"¿Te interesa la moda y joyería?"},
    {carreras:["Actuación","Danza","Teatro","Modelaje"], q:"¿Prefieres la expresión escénica?"},
    {carreras:["Fotografía","Fotografía Digital","Producción Audiovisual y Multimedia","Cine y Video"], q:"¿Quieres el arte visual y audiovisual?"}
  ],
  "Inglés":[
    {carreras:["Pedagogía en Inglés (Lengua Extranjera)"], q:"¿Quieres enseñar inglés?"},
    {carreras:["Traducción Simultánea","Traducción e Interpretación"], q:"¿Prefieres trabajar en la traducción e interpretación?"},
    {carreras:["Relaciones Internacionales y Diplomacia","Educación Internacional"], q:"¿Te motiva el trabajo internacional?"},
    {carreras:["Idiomas","Comunicación y Publicidad"], q:"¿Quieres enfocarte en idiomas aplicados a comunicación?"}
  ]
};

/* ===== Lógica y render ===== */
const app = document.getElementById('app');
let respuestas1 = {}, notas = {}, mejoresAreas = [];

function renderNivel1(){
  app.innerHTML = "<h2>Nivel 1 – Selecciona tu interés en cada área</h2>";
  nivel1.forEach(({area,q})=>{
    app.innerHTML += `<div class="pregunta">
      <div class="area">${area}</div>
      <p>${q}</p>
      <label><input type="radio" name="${area}" value="1"> Sí</label>
      &nbsp;&nbsp;
      <label><input type="radio" name="${area}" value="0"> No</label>
    </div>`;
  });
  app.innerHTML += `<button class="btn" onclick="pedirNotas()">Continuar</button>`;
}

function pedirNotas(){
  respuestas1 = {};
  nivel1.forEach(({area})=>{
    const checked = document.querySelector('input[name="'+area+'"]:checked');
    if(checked) respuestas1[area] = parseInt(checked.value);
  });

  // Mostrar inputs de nota solo para áreas con respuesta "Sí"
  app.innerHTML = "<h2>Ingresa tus notas (último año de bachillerato) — solo para las áreas marcadas Sí</h2>";
  let any = false;
  Object.keys(respuestas1).forEach(area=>{
    if(respuestas1[area]===1){
      any = true;
      app.innerHTML += `<div class="pregunta">
        <div class="area">${area}</div>
        <p>Nota en el último año (ej. 8.5)</p>
        <input type="number" step="0.1" min="0" max="10" id="nota-${escapeId(area)}" placeholder="Ej. 8.5">
      </div>`;
    }
  });
  if(!any){
    app.innerHTML += `<p>No marcaste ninguna área con "Sí". Puedes volver y responder algunas preguntas.</p>`;
  }
  app.innerHTML += `<button class="btn" onclick="calcularTop2()">Siguiente</button>`;
}

function calcularTop2(){
  notas = {};
  Object.keys(respuestas1).forEach(area=>{
    if(respuestas1[area]===1){
      const val = parseFloat(document.getElementById('nota-'+escapeId(area)).value || "0");
      notas[area] = isNaN(val) ? 0 : val;
    }
  });
  // ordenar y tomar las 2 mejores áreas por nota
  mejoresAreas = Object.entries(notas)
    .sort((a,b)=>b[1]-a[1])
    .slice(0,2)
    .map(x=>x[0]);

  if(mejoresAreas.length === 0){
    app.innerHTML = "<p>No se ingresaron notas válidas. Regresa y completa las notas (usa formato 0.0 - 10.0).</p><button class='btn' onclick='renderNivel1()'>Volver</button>";
    return;
  }
  renderNivel2();
}

function renderNivel2(){
  app.innerHTML = "<h2>Nivel 2 – Preguntas específicas (solo para tus 2 mejores áreas)</h2>";
  mejoresAreas.forEach((area, areaIdx)=>{
    app.innerHTML += `<h3>${area}</h3>`;
    const preguntas = nivel2[area];
    if(!preguntas || preguntas.length===0){
      app.innerHTML += `<p>(No hay preguntas definidas para esta área)</p>`;
      return;
    }
    preguntas.forEach((p, i)=>{
      const qname = `q-${areaIdx}-${i}`;
      const carrerasStr = p.carreras.join(",");
      app.innerHTML += `<div class="pregunta">
        <p><b>${p.q}</b></p>
        <label><input data-carreras="${escapeAttr(carrerasStr)}" type="radio" name="${qname}" value="1"> Sí</label>
        &nbsp;&nbsp;
        <label><input data-carreras="${escapeAttr(carrerasStr)}" type="radio" name="${qname}" value="0"> No</label>
      </div>`;
    });
  });
  app.innerHTML += `<button class="btn" onclick="mostrarResultado()">Ver Resultado</button>`;
}

function mostrarResultado(){
  const scores = {};
  // revisar todas las respuestas seleccionadas en nivel2
  document.querySelectorAll('input[data-carreras]:checked').forEach(inp=>{
    const v = parseInt(inp.value) || 0;
    const carreras = (inp.dataset.carreras || "").split(",").map(s=>s.trim()).filter(Boolean);
    carreras.forEach(c=>{
      scores[c] = (scores[c] || 0) + v;
    });
  });

  // si no hay respuestas en nivel2 (por ejemplo el usuario no seleccionó nada), avisar
  if(Object.keys(scores).length === 0){
    app.innerHTML = "<p>No seleccionaste respuestas en Nivel 2. Por favor responde las preguntas y vuelve a intentar.</p><button class='btn' onclick='renderNivel2()'>Volver a Nivel 2</button>";
    return;
  }

  // ordenar y entregar top 3 (o menos si no hay)
  const top = Object.entries(scores).sort((a,b)=>b[1]-a[1]).slice(0,3);
  app.innerHTML = "<h2>🎯 Tus 3 carreras recomendadas:</h2>";
  app.innerHTML += "<ul>" + top.map(t=>`<li><b>${t[0]}</b> (puntaje: ${t[1]})</li>`).join("") + "</ul>";
  app.innerHTML += `<p>Puedes usar estos resultados para mostrar descripciones, enlaces a universidades o sugerencias de búsqueda.</p>`;
  app.innerHTML += `<button class="btn" onclick="renderNivel1()">Hacer test de nuevo</button>`;
}

/* utilidades para ids seguros en DOM */
function escapeId(s){ return s.replace(/[^a-z0-9]/gi, '_'); }
function escapeAttr(s){ return s.replace(/"/g,'&quot;'); }

/* iniciar */
renderNivel1();
</script>
</body>
</html>
