    {carreras:["Pedagogía en Matemáticas"], q:"¿Te apasiona la docencia y explicación de problemas matemáticos?"},
    {carreras:["Ingeniería en Estadística","Estadística Informática"], q:"¿Te interesa la estadística aplicada a negocios y ciencias?"},
    {carreras:["Programación y Desarrollo de Sistemas","Ingeniería en Sistemas Computacionales","Tecnología en Informática Educativa","Telemática"], q:"¿Prefieres la programación y sistemas informáticos?"},
    {carreras:["Ingeniería Industrial","Ingeniería Comercial","Ciencias Económicas y Financieras","Banca y Finanzas"], q:"¿Quieres aplicar matemáticas en el mundo empresarial y financiero?"}
  ],
  "Biología":[
    {carreras:["Pedagogía en Biología"], q:"¿Quieres dedicarte a la docencia en biología?"},
    {carreras:["Veterinaria","Zootecnia"], q:"¿Prefieres trabajar con animales?"},
    {carreras:["Biotecnología","Bioanálisis","Biotecnología Ambiental"], q:"¿Te interesa la biotecnología e investigación científica?"},
    {carreras:["Ciencias Ambientales","Biología Marina","Oceanografía y Ciencias Ambientales"], q:"¿Quieres trabajar en el medio ambiente?"},
    {carreras:["Agronomía","Horticultura y Fruticultura"], q:"¿Prefieres el sector agrícola o productivo?"}
  ],
  "Física":[
    {carreras:["Pedagogía en Física"], q:"¿Quieres enseñar física y ciencias exactas?"},
    {carreras:["Ingeniería Mecánica","Ingeniería Automotriz","Ingeniería Mecatrónica (Robótica)"], q:"¿Prefieres la ingeniería mecánica, automotriz o mecatrónica?"},
    {carreras:["Física","Astronomía"], q:"¿Te atrae el espacio y el cosmos?"},
    {carreras:["Mecatrónica (Robótica)","Telecomunicaciones","Electrónica","Imagen y Sonido"], q:"¿Quieres aplicar física en tecnología e innovación?"},
    {carreras:["Ingeniería Civil","Ingeniería en Costas y Obras Portuarias","Ingeniería en Ciencias Geográficas y Desarrollo Sustentable"], q:"¿Prefieres la construcción e infraestructura?"}
  ],
  "Química":[
